# Styx Universal Email Connector Configuration
HTTP_PORT=8771
HTTP_HOST=0.0.0.0

# Email Provider presets: gmail | outlook | icloud | yahoo | fastmail | custom
EMAIL_PROVIDER=gmail

# If using EMAIL_PROVIDER=gmail:
# IMAP_HOST and SMTP_HOST will default automatically.
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx  (Google App Password)

# Manual Server Configuration (for custom/self-hosted providers)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

EMAIL_USER=
EMAIL_PASS=

# Enable real-time IMAP IDLE push notifications for incoming emails
ENABLE_IDLE=true

# Styx Agent OS Gateway Integration
STYX_API_URL=http://localhost:3000
STYX_ACCESS_KEY=styx-local-dev-key
LOG_LEVEL=info
