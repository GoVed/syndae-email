# Styx Universal Email Connector Configuration
HTTP_PORT=8771
HTTP_HOST=0.0.0.0

# Email Provider presets: gmail | outlook | icloud | yahoo | fastmail | custom
EMAIL_PROVIDER=gmail

# Modern Auth (OAuth 2.0 PKCE / XOAUTH2)
# Connect interactively via browser at http://localhost:8771/auth/connect?provider=gmail
# Tokens are stored securely in data/accounts.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Alternatively, configure a single primary account via App Password or OAuth Refresh Token:
EMAIL_USER=
EMAIL_PASS=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REFRESH_TOKEN=

# Manual Server Configuration (for custom/self-hosted providers)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Enable real-time IMAP IDLE push notifications for incoming emails
ENABLE_IDLE=true

# Styx Agent OS Gateway Integration
STYX_API_URL=http://localhost:3000
STYX_ACCESS_KEY=styx-local-dev-key
LOG_LEVEL=info
